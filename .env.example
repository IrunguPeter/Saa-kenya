# Copy this file to .env and edit the values to match your setup.
# Port the web server runs on
PORT=3000

# --- PostgreSQL / Supabase connection ---
# Preferred: a single connection URL (e.g. from Supabase).
# Use the Pooler connection string from
#   Supabase Dashboard > Project Settings > Database > Connection pooling >
#   Transaction (or Session) pooler => postgresql://...pooler.supabase.com:6543/postgres
# Appending ?ssl=true is safe (TLS is required by Supabase).
# DATABASE_URL=postgresql://postgres.yourref:password@aws-0-region.pooler.supabase.com:6543/postgres?ssl=true

# --- OR individual variables (local Postgres) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=watch_user
DB_PASSWORD=watch_pass
DB_NAME=watch_store
# DB_SSL=true

# Connection pool size (keep small on serverless)
# DB_POOL_LIMIT=2

# Admin portal password (REQUIRED — the server will not start without it).
# Use a strong password (8+ chars, upper/lowercase + numbers).
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Affiliate program ---
# Signing secret for affiliate session tokens (falls back to ADMIN_PASSWORD).
# AFFILIATE_SECRET=change-me-too
# Commission share of the paid order total (default 0.10 = 10%).
# AFFILIATE_COMMISSION_RATE=0.10
# How long the ?ref= cookie lasts (days, default 30).
# AFFILIATE_COOKIE_DAYS=30
# Minimum balance before an affiliate can request a payout (KSh, default 500).
# AFFILIATE_MIN_PAYOUT=500

# --- Site ---
# Public base URL used to build affiliate referral links (optional; falls back
# to the incoming request host).
# SITE_URL=https://saakenya.xyz

# --- Order notifications ---
# Resend API key (https://resend.com) used to email the admin on new orders.
# Starts with "re_".
# RESEND_API_KEY=re_xxxxxxxx
# Email address that receives the new-order alerts.
# ADMIN_EMAIL=you@example.com
# "From" address shown on order alert emails. Use a domain verified in Resend,
# otherwise leave commented to use Resend's test sender.
# MAIL_FROM=Saa Kenya <notifications@yourdomain.com>

# Web Push (browser desktop notifications for the admin dashboard).
# Generate a key pair once with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
# mailto: must match a verified address for this origin.
WEB_PUSH_VAPID_EMAIL=mailto:you@example.com
