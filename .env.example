# Copy this file to .env and edit the values to match your setup.
# Port the web server runs on
PORT=3000

# --- Local MariaDB connection details ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=watch_user
DB_PASSWORD=watch_pass
DB_NAME=watch_store

# --- OR use a single connection URL (preferred on Vercel) ---
# MySQL-compatible DSN, e.g. from a managed MySQL provider.
# Append ?ssl=true if your provider requires TLS.
# DATABASE_URL=mysql://user:password@host:3306/dbname?ssl=true
# DB_SSL=true

# Connection pool size (keep small on serverless)
# DB_POOL_LIMIT=2

# Admin portal password (change this!)
ADMIN_PASSWORD=admin123
